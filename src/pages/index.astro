  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { SplitText } from 'gsap/SplitText';

    const topo = document.getElementById('topo');
    const marcar = () => topo?.classList.toggle('rolou', window.scrollY > 8);
    marcar();
    window.addEventListener('scroll', marcar, { passive: true });

    const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Nó ativo na linha do dia (funciona também sem animação).
    gsap.registerPlugin(ScrollTrigger, SplitText);
    document.querySelectorAll<HTMLElement>('.cena').forEach((cena) => {
      ScrollTrigger.create({
        trigger: cena,
        start: 'top 60%',
        end: 'bottom 40%',
        onToggle: (s) => cena.classList.toggle('ativa', s.isActive),
      });
    });

    if (!reduzir) {
      // Abertura: o título surge linha por linha e a régua do dia é desenhada uma vez.
      document.fonts.ready.then(() => {
        const split = SplitText.create('.titulo-abertura', { type: 'lines', mask: 'lines' });
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        tl.from(split.lines, { yPercent: 105, duration: 0.9, stagger: 0.09 })
          .from('.trilho-abertura .feito', { scaleX: 0, duration: 1.4, ease: 'power2.inOut' }, '-=0.3')
          .from('.trilho-abertura .no', { scale: 0, duration: 0.35, stagger: 0.22 }, '<0.1')
          .from('.trilho-abertura .resto', { opacity: 0, duration: 0.6 }, '-=0.2');
      });

      // A espinha do dia acompanha a rolagem.
      const progresso = document.querySelector<HTMLElement>('.espinha .progresso');
      if (progresso) {
        gsap.set(progresso, { scaleY: 0 });
        gsap.to(progresso, {
          scaleY: 1, ease: 'none',
          scrollTrigger: { trigger: '.cenas', start: 'top 60%', end: 'bottom 60%', scrub: 0.4 },
        });
      }

      // Em cada cena, os números da tela se preenchem e o gráfico é traçado.
      document.querySelectorAll<HTMLElement>('[data-contar]').forEach((el) => {
        const alvo = Number(el.dataset.contar);
        const sufixo = el.dataset.sufixo ?? '';
        const obj = { v: 0 };
        gsap.to(obj, {
          v: alvo, duration: 1.2, ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 80%', once: true },
          onUpdate: () => { el.textContent = Math.round(obj.v) + sufixo; },
        });
      });
      const traco = document.querySelector<SVGPathElement>('.traco');
      if (traco) {
        const comp = traco.getTotalLength();
        gsap.fromTo(traco, { strokeDasharray: comp, strokeDashoffset: comp }, {
          strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut',
          scrollTrigger: { trigger: traco, start: 'top 85%', once: true },
        });
      }

      // A linha das etapas de implantação é desenhada ao chegar nela.
      gsap.from('.linha-etapas .feito', {
        scaleX: 0, duration: 1.4, ease: 'power2.inOut',
        scrollTrigger: { trigger: '.linha-etapas', start: 'top 80%', once: true },
      });
    }
  </script>
